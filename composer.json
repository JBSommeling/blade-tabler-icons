{
    "name": "jbsommeling/blade-tabler-icons",
    "description": "A package to easily make use of Tabler icons in your Laravel Blade views.",
    "keywords": [
        "Blade",
        "Tabler",
        "Laravel"
    ],
    "homepage": "https://github.com/JBSommeling/blade-tabler-icons",
    "license": "MIT",
    "authors": [
        {
            "name": "J.B. Sommeling",
            "email": "jesse@sommeling.dev",
            "homepage": "https://sommeling.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "blade-ui-kit/blade-icons": "^1.5",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.14",
        "orchestra/testbench": "^8.0 || ^9.0",
        "phpunit/phpunit": "^9.5.10 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "JBSommeling\\TablerIcons\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JBSommeling\\TablerIcons\\BladeTablerIconsServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": [
            "vendor/bin/php-cs-fixer fix"
        ],
        "update-icons": [
            "npm install",
            "./bin/compile.sh ./node_modules/@tabler/icons/icons"
        ],
        "test": "vendor/bin/phpunit --colors=always"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
